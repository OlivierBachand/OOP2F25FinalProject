<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="475.0" prefWidth="475.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop2f25finalproject.Controllers.ManagerViewController">
   <children>
      <GridPane layoutX="67.0" layoutY="86.0" prefHeight="334.0" prefWidth="347.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Movies:" GridPane.halignment="RIGHT" />
            <Label text="Screening Rooms:" GridPane.halignment="RIGHT" GridPane.rowIndex="1" />
            <Label text="Ticket Sales by movie:" GridPane.halignment="RIGHT" GridPane.rowIndex="2" />
            <Label text="Ticket Sales by show time:" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
            <Button mnemonicParsing="false" onAction="#onManageMoviesButtonClick" text="Manage" GridPane.columnIndex="1" GridPane.halignment="LEFT">
               <GridPane.margin>
                  <Insets left="20.0" />
               </GridPane.margin></Button>
            <Button mnemonicParsing="false" onAction="#onManageRoomsButtonClick" text="Manage" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="1">
               <GridPane.margin>
                  <Insets left="20.0" />
               </GridPane.margin></Button>
            <Button mnemonicParsing="false" onAction="#onViewSalesMovieButtonClick" text="View" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="2">
               <GridPane.margin>
                  <Insets left="20.0" />
               </GridPane.margin></Button>
            <Button mnemonicParsing="false" onAction="#onViewSalesShowTimeButtonClick" text="View" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="3">
               <GridPane.margin>
                  <Insets left="20.0" />
               </GridPane.margin></Button>
         </children>
      </GridPane>
      <Label layoutX="180.0" layoutY="38.0" text="Manager View">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button layoutX="392.0" layoutY="26.0" mnemonicParsing="false" onAction="#onCloseButtonClick" text="Close" />
      <Button fx:id="aLogOutButton" layoutX="39.0" layoutY="26.0" mnemonicParsing="false" onAction="#onLogOutButtonClick" text="Log out" />
   </children>
</AnchorPane>
